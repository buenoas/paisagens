# Carrega os pacotes necessarios
library(shiny)
library(ggplot2)
library(plotly)
library(terra)
library(ggpubr)

# Load and prepare your data
frags = vect("https://raw.githubusercontent.com/buenoas/paisagens/main/fragmentos_265_6-7ha_1000m.shp")
s = as.data.frame(frags)

# Extrai coordenadas dos centroides
centroids = centroids(frags)
coords = crds(centroids)
s$x = coords[,1]
s$y = coords[,2]

# Adiciona índice de linha
s$id_row = 1:nrow(s)

# Adiciona seleção
selecao_40 = c(1, 8, 12, 22, 25, 36, 41, 42, 46, 56, 60, 63, 69, 70, 71, 76, 77, 88, 109, 131, 132, 136, 139, 140, 141, 153, 157, 159, 164, 180, 181, 197, 227, 228, 240, 247, 251, 253, 262, 263)
s$selecao = FALSE
s$selecao[selecao_40] = TRUE

# Categorias de forma
s$shape_cat = NA
s$shape_cat[s$shape < 2.33] = "regular"
s$shape_cat[s$shape > 2.84] = "irregular"

# Filtrar NAs para o gráfico
s_filtered = s[!is.na(s$shape) & !is.na(s$floresta_0), ]

ui = fluidPage(
  h3("Clique nos pontos para ver/copiar os valores XY"),
  fluidRow(
    column(6, plotlyOutput("plot")),
    column(6, plotlyOutput("mapPlot"))
  ),
  verbatimTextOutput("clickInfo"),
  downloadButton("downloadData", "Baixar pontos clicados")
)

server = function(input, output, session) {
  
  clicked_points = reactiveVal(data.frame(
    floresta_p = numeric(),
    shape = numeric(),
    x = numeric(),
    y = numeric()
  ))
  
  output$plot = renderPlotly({
    p = ggplot(data = s_filtered,
               aes(x = floresta_0,
                   y = shape,
                   fill = shape_cat,
                   alpha = selecao)) +
      geom_vline(xintercept = seq(0, 45, 5),
                 linetype = "dashed", colour = "grey") +
      geom_point(aes(customdata = id_row),  # Passa o id_row como customdata!
                 size = 2.5, stroke = 1/3,
                 shape = 21, colour = "black") +
      theme_pubr() +
      theme(plot.title = element_text(hjust = 0.5),
            legend.position = "none") +
      labs(y = "Índice de forma",
           x = "Cobertura florestal no entorno de 1 km (%)",
           fill = "Forma do fragmento",
           title = "Fragmentos florestais entre 6 e 7 ha\n")
    
    ggplotly(p, tooltip = c("x", "y", "customdata"), source = "scatter")
  })
  
  observeEvent(event_data("plotly_click", source = "scatter"), {
    click = event_data("plotly_click", source = "scatter")
    if (!is.null(click)) {
      idx = click$customdata  # <- Agora usamos o customdata
      new_row = data.frame(
        floresta_p = s$floresta_0[idx],
        shape = s$shape[idx],
        x = s$x[idx],
        y = s$y[idx]
      )
      current = clicked_points()
      clicked_points(rbind(current, new_row))
    }
  })
  
  output$clickInfo = renderPrint({
    pts = clicked_points()
    if (nrow(pts) == 0) {
      cat("Clique nos pontos do gráfico para registrar os valores de X e Y.")
    } else {
      print(pts)
    }
  })
  
  output$downloadData = downloadHandler(
    filename = function() "pontos_clicados.csv",
    content = function(file) {
      write.csv(clicked_points(), file, row.names = FALSE)
    }
  )
  
  output$mapPlot = renderPlotly({
    map_data = data.frame(
      x = s$x,
      y = s$y
    )
    
    p = ggplot(map_data, aes(x = x, y = y)) +
      geom_point(color = "grey") +
      theme_minimal() +
      labs(x = "Longitude", y = "Latitude", title = "Localização dos fragmentos")
    
    pts = clicked_points()
    if (nrow(pts) > 0) {
      p = p + geom_point(data = pts, aes(x = x, y = y), color = "red", size = 2.5)
    }
    
    ggplotly(p)
  })
}

shinyApp(ui, server)
